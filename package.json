{
  "name": "convex-runtime-tables",
  "description": "Runtime-defined tables, records, and indexes for Convex applications.",
  "repository": "github:valentindoering/convex-runtime-tables",
  "homepage": "https://github.com/valentindoering/convex-runtime-tables#readme",
  "bugs": {
    "url": "https://github.com/valentindoering/convex-runtime-tables/issues"
  },
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component",
    "runtime-schema",
    "dynamic-tables"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "build": "node scripts/clean-dist.mjs && tsc --project ./tsconfig.build.json",
    "build:showcase": "vite build example",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "check:codegen": "npm run build:codegen && git diff --exit-code -- src/component/_generated example/convex/_generated",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:race": "vitest run src/component/lifecycle.race.test.ts && npm run test:real-concurrency",
    "test:real-concurrency": "node scripts/real-concurrency.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:reactivity": "node scripts/consumer-smoke.mjs --reactivity",
    "test:scale": "node scripts/live-scale.mjs",
    "upload:showcase": "static-hosting upload --dist example/dist --component selfHosting --spa",
    "changeset": "changeset",
    "prepare": "npm run build",
    "preversion": "node scripts/release-blocked.mjs",
    "prepublishOnly": "node scripts/release-blocked.mjs",
    "alpha": "node scripts/release-blocked.mjs",
    "release": "node scripts/release-blocked.mjs",
    "version": "node scripts/release-blocked.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "convex": "^1.44.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "chokidar-cli": "3.0.0",
    "convex": "^1.44.0",
    "convex-test": "0.0.55",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "pkg-pr-new": "^0.0.86",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "sideEffects": false,
  "dependencies": {
    "convex-helpers": "^0.1.123"
  }
}
